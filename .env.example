# DineSense environment. Copy to `.env` at the repo root: `cp .env.example .env`.
# Never commit `.env`. Values below are safe local-development defaults only.

# ── Database (PostgreSQL 16) ───────────────────────────────────────────────
# Connection string used by the API and Prisma CLI.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dinesense
# Disposable database for integration tests (must contain "test" in the name; tests never delete data).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dinesense_test

# ── Redis (BullMQ timers from M5, PIN lockout counters now) ────────────────
REDIS_URL=redis://localhost:6379
# Redis DB used by tests.
TEST_REDIS_URL=redis://localhost:6379/15

# ── API ────────────────────────────────────────────────────────────────────
PORT=4000
# HMAC secret for access tokens. ≥32 chars. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-dev-only-access-secret-0123456789
# Access token lifetime (seconds). Short by design; clients refresh silently.
JWT_ACCESS_TTL_SECONDS=900
# Refresh token lifetime (days). Rotated on every use; reuse revokes the session family.
REFRESH_TTL_DAYS=14
# Browser origins allowed to call the API (dashboard, guest, staff apps).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# PIN brute-force protection: failed attempts per user before lockout, and lockout length.
PIN_MAX_ATTEMPTS=5
PIN_LOCKOUT_SECONDS=900
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── Added in later milestones (documented here so nothing is a surprise) ──
# M4 web push (VAPID, free, no third-party account). Generate: pnpm dlx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com
# M7 Razorpay pay-at-table (PAID SERVICE — per-transaction fees on live keys; owner approved TEST MODE only).
# Online payment stays off until all three are set AND Settings → Online payments is ticked.
# Dashboard → Account & Settings → API Keys (test mode: rzp_test_…). Never commit real keys.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# Webhooks → add https://<api-host>/api/v1/payments/razorpay/webhook for payment.captured, order.paid,
# payment.failed; paste the secret you chose there.
# RAZORPAY_WEBHOOK_SECRET=
# Only for tests/mocks; defaults to https://api.razorpay.com/v1.
# RAZORPAY_API_URL=

# ── Dashboard (Next.js) — read at BUILD time ───────────────────────────────
# Where the dashboard server proxies /api/v1 (same-origin, so the refresh cookie works).
API_URL=http://localhost:4000
# Where browsers open the Socket.IO connection for live updates.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Express trust proxy: hops allowed to set X-Forwarded-For (guest rate limits key on the client IP).
# Behind a load balancer set its address/CIDR, e.g. "loopback, 10.0.0.0/8".
TRUST_PROXY=loopback, uniquelocal
# Seconds during which a just-rotated refresh token may be presented again (lost response) without revoking the session.
REFRESH_REUSE_GRACE_SECONDS=20

# ── Greet SLA engine (M5) ──────────────────────────────────────────────────
# Run the BullMQ worker in this API process. Set "false" on extra API replicas if you want a single worker.
SLA_WORKER_ENABLED=true
# Safety-net sweep that re-checks every open, un-greeted table (seconds; 0 disables).
SLA_RECONCILE_SECONDS=30
# Redis key prefix for BullMQ (separates environments sharing one Redis).
BULLMQ_PREFIX=dinesense

# ── Edge vision devices & cameras (M6) ─────────────────────────────────────
# Derives each edge device's HMAC secret (≥32 chars). Changing it invalidates every device's secret.
# Generate: openssl rand -base64 48. Dev default is derived from JWT_ACCESS_SECRET — set it in production.
# EDGE_SECRET_KEY=
# AES-256-GCM key for camera RTSP URLs (they contain camera passwords): 32 bytes, base64.
# Generate: openssl rand -base64 32. Dev default is derived from JWT_ACCESS_SECRET — set it in production.
# CAMERA_SECRET_KEY=
# How often silent cameras / edge devices are marked offline (seconds; 0 disables).
EDGE_HEALTH_SWEEP_SECONDS=30
# ── Guests & bookings (M8) ──
# How often guest data past its retention period is erased (seconds; 0 disables). Period: Settings → Privacy.
GUEST_RETENTION_SWEEP_SECONDS=3600
# How often tables are held before bookings and no-shows are released (seconds; 0 disables).
RESERVATION_SWEEP_SECONDS=30
# ── Guest messaging (M9) ──
# Public URL of the guest app; used in message links (manage booking, waitlist status).
GUEST_APP_URL=http://localhost:3001
# How often queued guest messages are sent (seconds; 0 disables).
MESSAGE_DISPATCH_SECONDS=5
# WhatsApp Cloud API (PAID SERVICE — Meta charges per conversation; owner approved building against the console
# channel first). Without ACCESS_TOKEN + PHONE_NUMBER_ID messages are only logged (console channel).
# Meta → WhatsApp → API setup. Register the templates in docs/whatsapp-templates.md first.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# Webhook: https://<api-host>/api/v1/messaging/whatsapp/webhook (fields: messages). App secret signs deliveries;
# the verify token is any string you also type into Meta's webhook setup.
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_API_URL=https://graph.facebook.com/v21.0

# ── Edge vision service (services/vision, runs at the outlet; reads DS_* from its own env/.env) ──
# API base URL as seen from the edge machine, including /api/v1.
# DS_API_URL=http://localhost:4000/api/v1
# Shown once when a manager registers the device (dashboard → Cameras). The secret is a credential: keep it on
# the edge machine only.
# DS_DEVICE_ID=
# DS_DEVICE_SECRET=
# true: cameras with file:// URLs loop local videos (dev/demo). Never needed in production.
# DS_DEV_MODE=false
# yolox (real cameras; `ds-vision fetch-model` downloads the Apache-2.0 weights) | synthetic (synth footage only)
# DS_DETECTOR=yolox
# DS_MODEL_PATH=models/yolox_s.onnx
