# DineSense environment. Copy to `.env` at the repo root: `cp .env.example .env`.
# Never commit `.env`. Values below are safe local-development defaults only.

# ── Database (PostgreSQL 16) ───────────────────────────────────────────────
# Connection string used by the API and Prisma CLI.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dinesense
# Disposable database for integration tests (must contain "test" in the name; tests never delete data).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dinesense_test

# ── Redis (BullMQ timers from M5, PIN lockout counters now) ────────────────
REDIS_URL=redis://localhost:6379
# Redis DB used by tests.
TEST_REDIS_URL=redis://localhost:6379/15

# ── API ────────────────────────────────────────────────────────────────────
PORT=4000
# HMAC secret for access tokens. ≥32 chars. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-dev-only-access-secret-0123456789
# Access token lifetime (seconds). Short by design; clients refresh silently.
JWT_ACCESS_TTL_SECONDS=900
# Refresh token lifetime (days). Rotated on every use; reuse revokes the session family.
REFRESH_TTL_DAYS=14
# Browser origins allowed to call the API (dashboard, guest, staff apps).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# PIN brute-force protection: failed attempts per user before lockout, and lockout length.
PIN_MAX_ATTEMPTS=5
PIN_LOCKOUT_SECONDS=900
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── Added in later milestones (documented here so nothing is a surprise) ──
# M4 web push (VAPID, free, no third-party account). Generate: pnpm dlx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com
# M6 AES-256-GCM key for camera RTSP URLs at rest (32 bytes, base64). Generate: openssl rand -base64 32
# CAMERA_SECRET_KEY=
# M7 Razorpay (PAID SERVICE — per-transaction fees; will ask before enabling). Use test-mode keys first.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ── Dashboard (Next.js) — read at BUILD time ───────────────────────────────
# Where the dashboard server proxies /api/v1 (same-origin, so the refresh cookie works).
API_URL=http://localhost:4000
# Where browsers open the Socket.IO connection for live updates.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Express trust proxy: hops allowed to set X-Forwarded-For (guest rate limits key on the client IP).
# Behind a load balancer set its address/CIDR, e.g. "loopback, 10.0.0.0/8".
TRUST_PROXY=loopback, uniquelocal
